# .env.example — Copy this to .env and fill in your credentials
# NEVER commit .env to version control

# Gmail API (for future Gmail watcher)
# GMAIL_CLIENT_ID=your_client_id
# GMAIL_CLIENT_SECRET=your_client_secret
# GMAIL_REDIRECT_URI=http://localhost:8080

# WhatsApp (for future WhatsApp watcher)
# WHATSAPP_SESSION_PATH=/path/to/session

# Banking APIs (for future finance watcher)
# BANK_API_TOKEN=your_token
# BANK_API_URL=https://api.yourbank.com

# Development mode — set to 'true' to prevent real external actions
DEV_MODE=true

# Dry run — log actions without executing
DRY_RUN=true
